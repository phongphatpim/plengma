# ─── PlengMa Environment Variables ──────────────────────────
# Copy this file to .env.local for local development
# Add these to Vercel dashboard → Settings → Environment Variables

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.plengma.com
NEXT_PUBLIC_APP_ENV=production
ADMIN_PASSWORD=replace_with_strong_admin_password

# ── Email (สำหรับแจ้งผลรีวิว) ───────────────────────────────
# Phase 1: ใช้ Resend หรือ SendGrid
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=hello@plengma.com
# ADMIN_EMAIL=admin@plengma.com

# ── Storage (Phase 1: cover upload) ─────────────────────────
# ใช้ Vercel Blob หรือ Cloudflare R2
# BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxxxxxxxxx

# ── Database (Phase 1) ──────────────────────────────────────
# ใช้ Vercel Postgres หรือ PlanetScale
# DATABASE_URL=postgres://xxxxxxxxxxxx

# ── Analytics (optional) ────────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
